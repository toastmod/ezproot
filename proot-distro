#!/bin/bash

mkdir -p .ezproot

if [ ! -f "./.ezproot/setup-complete" ]; then
    echo "Setting up proot-distro for the first time..."
    set -e
    ./scripts/setup.sh
    set +e
    touch .ezproot/setup-complete
fi

. .venv/bin/activate
PD_PROOT_BIN=$PWD/bin/proot TERMUX__PREFIX=$PWD/usr TERMUX__HOME=$PWD/home proot-distro "$@"
